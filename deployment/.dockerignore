# Docker build context exclusions - keep image small + reproducible

# Version control
.git/
.gitignore
.github/

# Documentation (lives outside the image)
docs/
README.md
*.md

# Tests (not needed at runtime; we test BEFORE building, not inside the image)
tests/
test_*.py
*_test.py
.pytest_cache/

# Tooling caches
__pycache__/
*.py[cod]
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Local env / secrets
.env
.env.*
.venv/
venv/

# Compose / Docker meta
docker-compose*.yml
Dockerfile*
.dockerignore

# Model artifacts - mounted as volumes or fetched from MLflow registry at startup
*.pth
*.npy
*.keras
*.h5
*.joblib
*.pkl

# Logs / IDE
*.log
.vscode/
.idea/