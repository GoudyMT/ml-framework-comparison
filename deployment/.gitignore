# Deployment-specific gitignore (root .gitignore covers project-wide patterns)

# Secrets - 12-factor env-var configuration; never commit
.env
.env.*
!.env.example

# Python build / cache
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
dist/
build/

# Tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml

# Virtual envs
.venv/
venv/
env/

# Docker
*.tar
docker-compose.override.yml

# MLflow registry - DB + artifact store regenerable from
# scripts/promote_to_registry.py; do not commit
mlflow.db
mlruns/

# Model artifacts
*.pth
*.npy
*.keras
*.h5
*.weights.h5
*.joblib
*.pkl
*.model

# Exceptions: small committed test fixtures (regeneration paths
# documented in each service's smoke_test.py docstring)
!services/sklearn-svc/scripts/sample_raw.npy
!services/pt-svc/scripts/sample_raw.npy

# Logs
*.log
logs/

# IDE
.vscode/
.idea/
*.swp
