# .dockerignore - filters the build context that gets sent to the Docker
# daemon. Anything matched here is NOT copied into the image and is invisible
# to COPY instructions in the Dockerfile. Smaller context = faster builds +
# no risk of accidentally bundling secrets, caches, or model artifacts.

# === Version control + repo metadata ===
.git/
.gitignore
.gitattributes
.github/

# === Documentation - lives outside the image ===
README.md
*.md
docs/

# === Python build / runtime caches ===
__pycache__/
*.py[cod]
*.so
.Python

# === Virtual environments - we BUILD a fresh venv inside the image ===
.venv/
venv/
env/

# === Test artifacts - tests run BEFORE build in CI; not needed at runtime ===
tests/
test_*.py
*_test.py
.pytest_cache/

# === Linter / type-checker caches ===
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# === Local env / secrets - never bake credentials into images ===
.env
.env.*
*.pem
*.key

# === Docker meta - the image doesn't need to know about itself ===
Dockerfile*
.dockerignore
docker-compose*.yml

# === IDE / editor noise ===
.vscode/
.idea/
*.swp
*.swo

# === OS-generated files ===
.DS_Store
Thumbs.db

# === Python build / install artifacts ===
build/
dist/
*.egg-info/
*.egg

# === Logs ===
*.log
logs/

# === Scripts directory - smoke tests + utility scripts, not runtime code ===
scripts/

# === Model artifacts - mounted as volumes from the host registry or pulled
#     from MLflow at startup; never baked in (keeps images small + decouples
#     model versions from image versions). tf-svc ships .h5 (Transformer
#     weights) and .keras (alternate serialization format) extensions; the
#     other entries are kept for cross-service parity even if not used here.
*.joblib
*.pkl
*.pth
*.npy
*.h5
*.keras

# === Lock-file source + non-runtime requirements - the production image only
#     needs requirements.txt (Linux lockfile, used by the builder stage).
#     pyproject.toml is for lock-file regen on the host; requirements-dev.txt
#     contains pytest/ruff/mypy not shipped to production; requirements-windows
#     is the host-dev lockfile, irrelevant inside a Linux container. ===
pyproject.toml
requirements-dev.txt
requirements-windows.txt
